# Required at build time for production metadata and crawler files.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Origin of the Django API in backend/. Server-only (not NEXT_PUBLIC_*), so the
# API origin never ships in the client bundle — anything needing API data is
# fetched during server rendering or inside a Server Action.
API_BASE_URL=http://127.0.0.1:8000

# Shared secret for POST /api/revalidate, which the Django admin calls after a
# save or delete so the public site refreshes at once. Must equal the backend's
# REVALIDATE_SECRET; unset leaves the endpoint closed.
# REVALIDATE_SECRET=
