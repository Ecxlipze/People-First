# Repo-wide ignores. Stack-specific rules live in frontend/.gitignore and
# backend/.gitignore so each workspace stays self-describing.

# macOS
.DS_Store

# Editors / local tooling
*.pem
*.log

# Secrets — every stack. Examples are committed, real values never are.
.env
.env.*
!.env.example

# Large binary drops that should not live in git history
*.zip

# Standalone coming-soon page (FTP-deployed, outside the Next build)
coming-soon/backups/
coming-soon/.deploy.env
