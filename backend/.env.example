# Copy to backend/.env and fill in. Never commit the real file.

SECRET_KEY=change-me
DEBUG=True

# Comma-separated hostnames Django will serve. May be empty while DEBUG=True;
# must be populated before DEBUG=False or every request is rejected.
ALLOWED_HOSTS=127.0.0.1,localhost

# Database engine: "sqlite3" or "postgresql". When unset, settings.py picks
# sqlite3 if backend/db.sqlite3 exists and postgresql otherwise — set it
# explicitly for anything but local scratch work.
DB_ENGINE=sqlite3

# Postgres connection (ignored when DB_ENGINE=sqlite3)
DB_NAME=people_first
DB_USER=postgres
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432

# Comma-separated origins allowed to call the API from a browser.
# Must include the Next.js dev origin and the deployed site origin.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Outgoing mail. The inquiry endpoint sends a confirmation to the submitter.
# For local work without an SMTP server, use the console backend:
#   EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
MAIL_HOST=localhost
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@peoplefirst.example
