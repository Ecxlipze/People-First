# Copy to backend/.env and fill in. Never commit the real file.

SECRET_KEY=change-me
DEBUG=True

# Comma-separated hostnames Django will serve. May be empty while DEBUG=True;
# must be populated before DEBUG=False or every request is rejected.
ALLOWED_HOSTS=127.0.0.1,localhost

# Database engine: "sqlite3" or "postgresql". When unset, settings.py picks
# sqlite3 if backend/db.sqlite3 exists and postgresql otherwise — set it
# explicitly for anything but local scratch work.
DB_ENGINE=sqlite3

# Postgres connection (ignored when DB_ENGINE=sqlite3).
# DB_PASSWORD has no fallback, so the key must be present when
# DB_ENGINE=postgresql. It may be empty for a server using trust or peer
# authentication — but it has to be an explicit, deliberate empty.
DB_NAME=people_first
DB_USER=postgres
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432

# Comma-separated origins allowed to call the API from a browser.
# Must include the Next.js dev origin and the deployed site origin.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Outgoing mail. The inquiry endpoint sends a confirmation to the submitter.

# Transport: smtp | log | file | array | null.
#   log   prints the message to the console (the usual local choice)
#   array keeps it in memory, file writes it under ../.local/emails
# An unrecognised value falls back to smtp.
MAIL_MAILER=smtp
# Optional escape hatch: a full Django backend import path, which overrides
# MAIL_MAILER entirely. Leave unset unless you need a backend not listed above.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend

MAIL_HOST=localhost
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# tls | ssl | none. Django cannot use both TLS and SSL, so this picks one.
# ssl is normally port 465, tls port 587.
MAIL_ENCRYPTION=tls

# The From identity. MAIL_FROM_NAME is the display name and may be omitted, in
# which case the bare address is used.
MAIL_FROM_ADDRESS=noreply@peoplefirst.example
MAIL_FROM_NAME="People First"
